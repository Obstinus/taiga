<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>moe.taiga.Taiga</id>
  <name>Taiga</name>
  <summary>Anime library and progress tracker</summary>
  <metadata_license>MIT</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer id="moe.taiga">
    <name>Taiga contributors</name>
  </developer>
  <description>
    <p>
      Taiga helps you organize an anime library, track watched episodes, and
      synchronize your list with AniList, Kitsu, or MyAnimeList.
    </p>
    <p>
      The Linux port detects playback from MPRIS-enabled media players and can
      recognize local files and supported streaming pages.
    </p>
  </description>
  <launchable type="desktop-id">taiga.desktop</launchable>
  <provides>
    <binary>taiga</binary>
  </provides>
  <url type="homepage">https://taiga.moe/</url>
  <url type="bugtracker">https://github.com/Obstinus/taiga/issues</url>
  <url type="vcs-browser">https://github.com/Obstinus/taiga</url>
  <categories>
    <category>AudioVideo</category>
  </categories>
  <keywords>
    <keyword>anime</keyword>
    <keyword>episodes</keyword>
    <keyword>tracker</keyword>
    <keyword>library</keyword>
  </keywords>
  <releases>
    <release version="2.0.1" date="2026-09-06">
      <description>
        <p>Release v2.0.1 with automated packaging and GitHub Releases integration.</p>
      </description>
    </release>
    <release version="2.0.0" date="2026-09-06">
      <description>
        <p>Initial Linux port packaging and desktop integration.</p>
      </description>
    </release>
  </releases>
</component>
